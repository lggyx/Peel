# Peel Server Environment Configuration
# Copy this file to .env.server and fill in your actual values

# Domain name (must resolve to your server)
CADDY_DOMAIN=peel.lggyx.com

# StepFun API Configuration
STEPFUN_API_KEY=your-stepfun-api-key-here
STEPFUN_MODEL=step-3.6
STEPFUN_URL=https://api.stepfun.com/v1/chat/completions

# CORS Origin (your frontend domain, comma-separated for multiple)
CORS_ORIGIN=https://peel.lggyx.com

# Public Base URL (used for generating absolute URLs)
PUBLIC_BASE_URL=https://peel.lggyx.com

# Max video download size (bytes, default 128MB)
MAX_DOWNLOAD_BYTES=134217728
